# Maintainer: Suhas Dissanayake <suhasdissa@gmail.com>
pkgname=quickshare-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Quick Share client for Linux: share files with nearby Android devices over Bluetooth and Wi-Fi"
arch=('x86_64')
url="https://github.com/SuhasDissa/QuickShareLinux"
license=('GPL-3.0-only' 'Apache-2.0')
# qt6-svg supplies the SVG image-format and icon-engine plugins (runtime only); qt6-wayland is the
# Wayland platform plugin.
depends=(
    'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland'
    'abseil-cpp' 'protobuf' 'openssl' 'sdbus-cpp'
    'bluez-libs' 'systemd-libs' 'curl'
)
# Talked to over D-Bus at runtime, none of them is linked.
optdepends=(
    'bluez: Bluetooth discovery and transfers'
    'networkmanager: Wi-Fi Direct and hotspot connections'
    'avahi: mDNS discovery on the local network'
    'xdg-desktop-portal: native file picker'
)
makedepends=('cmake' 'ninja' 'git' 'pkgconf' 'nlohmann-json' 'gtest')
options=('!debug')
_commit="${_commit:-main}"
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DQUICKSHARE_QML_SOURCE_DIR=
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
